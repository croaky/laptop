# The first change a repo earns on a sockeye instance: a Checkfile, so
# its own push proves the runners end to end (Dan 9/28).
#
# bin/ is the shell nobody compiles. SC2029 stays excluded:
# vm-bootstrap passes "$user" and friends into a remote heredoc, and
# expanding them on the client side is how the values reach the box.
shellcheck: git ls-files -z '*.sh' 'bin/*' shell/bashrc | xargs -0 shellcheck -e SC2029

# Neovim formats Lua with stylua on save, so a file that stylua would
# change puts an unrelated hunk in the next change that saves it. The
# runner and laptop.sh pin the same stylua version.
stylua: git ls-files -z '*.lua' | xargs -0 stylua --check

# The tests that need no Neovim and no plugins. The runner is Ubuntu
# with bash 5, and macOS runs scripts with /bin/bash 3.2. So run
# test/run.sh on the workstation too.
bashrc: test/bashrc_test.sh </dev/null
hostctl: test/hostctl_test.sh </dev/null
ssh: test/ssh_test.sh </dev/null
trust: test/trust_test.sh </dev/null

# The title a change needs to merge, and the body rules that come
# with it. sockeye reads this from main at merge.
merge: ^[a-z][a-z0-9_/-]*(?:, ?[a-z][a-z0-9_/-]*)*: [a-z](?:.{2,62})?(?:[^.\s]|\.\.\.)$
