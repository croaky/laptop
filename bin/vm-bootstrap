#!/bin/bash
#
# Bootstrap a fresh Ubicloud VM into a single-purpose host that an agent or
# service account operates: reachable over SSH on its public IP with public
# keys only, and an unprivileged user that has passwordless sudo.
#
# Assumes a freshly created Ubuntu 24.04 VM with my SSH key, still reachable
# on public port 22.
#
# Usage:
#   vm-bootstrap <public-ipv4> <hostname> <user> <public-key-file>
#
# <public-key-file> is the operator's ed25519 public key, installed as the
# new user's only authorized key. A public key carries no secrecy, so it may
# travel on the command line.
#
# Passwordless sudo is deliberate: the operator installs packages and restarts
# services unattended. Only run this on single-purpose VMs where that blast
# radius is acceptable.
#
# Port 22 stays open to the internet, so the sshd settings below are the only
# gate. Keep password and root login off.
#
# Afterwards, by hand:
#   1. Verify `ssh <user>@<public-ipv4>` works.
#   2. Ubicloud firewall: open only the ports the service needs.
#   3. Point DNS at the public IP.
#   4. Add the printed deploy key to the app repo if it needs to push.

set -euo pipefail

if [[ $# -ne 4 ]]; then
  echo "usage: vm-bootstrap <public-ipv4> <hostname> <user> <public-key-file>" >&2
  exit 1
fi

ip="$1"
name="$2"
user="$3"
pubkey_file="$4"
remote_user="${VM_BOOTSTRAP_USER:-croaky}"
host="$remote_user@$ip"

if [[ ! -r "$pubkey_file" ]]; then
  echo "cannot read public key: $pubkey_file" >&2
  exit 1
fi
pubkey="$(cat "$pubkey_file")"

if [[ "$pubkey" != ssh-* && "$pubkey" != ecdsa-* ]]; then
  echo "not an SSH public key: $pubkey_file" >&2
  exit 1
fi

ssh "$host" "USER_NAME='$user' NAME='$name' bash -s" <<'EOF'
set -euo pipefail
sudo hostnamectl set-hostname "$NAME"
sudo adduser --disabled-password --gecos "" "$USER_NAME"
echo "$USER_NAME ALL=(ALL) NOPASSWD:ALL" | sudo tee "/etc/sudoers.d/$USER_NAME" >/dev/null
sudo chmod 440 "/etc/sudoers.d/$USER_NAME"
EOF

# Public-key-only SSH: passwords and root stay off, and the operator's key is
# the only way in as the new user. The key is public, so the command string
# is a safe place for it.
ssh "$host" "USER_NAME='$user' PUBKEY='$pubkey' bash -s" <<'EOF'
set -euo pipefail
sudo -u "$USER_NAME" mkdir -p "/home/$USER_NAME/.ssh"
sudo -u "$USER_NAME" chmod 700 "/home/$USER_NAME/.ssh"
echo "$PUBKEY" | sudo -u "$USER_NAME" tee "/home/$USER_NAME/.ssh/authorized_keys" >/dev/null
sudo -u "$USER_NAME" chmod 600 "/home/$USER_NAME/.ssh/authorized_keys"
sudo sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
sudo sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
sudo sshd -t
sudo systemctl reload ssh
EOF

# Deploy key for pushing to a git remote. The private key stays on the VM, so
# nothing needs to live in a vault or be transmitted.
ssh "$host" "USER_NAME='$user' NAME='$name' bash -s" <<'EOF'
set -euo pipefail
sudo -u "$USER_NAME" -H env NAME="$NAME" bash <<'INNER'
set -euo pipefail
cd ~
ssh-keygen -t ed25519 -f .ssh/deploy -N "" -C "$NAME deploy key" >/dev/null
chmod 600 .ssh/deploy
cat > .ssh/config <<'CONF'
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/deploy
  IdentitiesOnly yes
CONF
chmod 600 .ssh/config
git config --global user.name "$NAME"
git config --global init.defaultBranch main
INNER
EOF

echo
echo "Deploy key (add to the app repo with write access if it needs to push):"
ssh "$host" "sudo -u '$user' cat /home/$user/.ssh/deploy.pub"

echo
echo "Keep this session open until 'ssh $user@$ip' is verified."
