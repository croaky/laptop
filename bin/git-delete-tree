#!/bin/sh

# git delete-tree -- drop the worktree you are standing in and its
# branch, leave the main checkout on an up-to-date main, and print that
# checkout's path.
#
# One line per thing it did, on stderr, because the path is the only
# thing on stdout: the shell function that owns the cd reads it. Git's
# own commands run quiet, since a fetch listing a deleted ref and a
# merge printing a diffstat say nothing a person asked for here.

set -e

if [ $# -ne 0 ]; then
  echo "usage: git delete-tree (run it from inside the worktree)" >&2
  exit 1
fi

main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
tree=$(git rev-parse --show-toplevel)
branch=$(git branch --show-current)

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "Error: refusing to delete $branch" >&2
  exit 1
fi

{
  if [ "$tree" = "$main" ]; then
    # The branch was never given a worktree of its own, so there is
    # nothing to remove and nothing named for it on disk.
    git -C "$main" checkout -q main
    echo "branch removed $branch"
  else
    git -C "$main" worktree remove "$tree"
    echo "worktree removed $(basename "$tree") ($tree)"
  fi

  git -C "$main" branch -q -D "$branch"

  git -C "$main" fetch -q origin
  git -C "$main" merge -q --ff-only origin/main
  git -C "$main" remote prune origin
  # Seven, which is what cibot abbreviates to on the merge line above
  # this one. Git's own --short is adaptive, so the two lines disagreed
  # about the length of the same commit.
  echo "main updated to $(git -C "$main" rev-parse --short=7 HEAD)"

  # What the repo does after a worktree goes, if it does anything. A
  # repo that gives every worktree its own database drops the one
  # nobody serves now, and migrates the main checkout's onto the commit
  # the merge above just landed. This script does not know that. The
  # clone's `tree.teardown` config key names a command, and this runs
  # it in the main checkout after main is up to date.
  #
  # Reported rather than fatal: the worktree is gone either way, and a
  # laptop with no Postgres running is a thing to say rather than a
  # reason to leave a branch behind. `cibot checkout` and `git
  # create-tree` read `tree.setup` the same way.
  teardown=$(git -C "$main" config --get tree.teardown || true)
  if [ -n "$teardown" ]; then
    (cd "$main" && sh -c "$teardown") ||
      echo "tree.teardown: failed"
  fi
} >&2

echo "$main"
