#!/bin/bash
#
# Find and replace by a given list of files.
#
# replace "find_this" "replace_with" **/*.rb

set -euo pipefail

find_this="$1"
shift
replace_with="$1"
shift

# Escape the sed delimiter and "&" in both strings.
sed_find=$(printf '%s' "$find_this" | sed 's/[\/&]/\\&/g')
sed_replace=$(printf '%s' "$replace_with" | sed 's/[\/&]/\\&/g')

# rg -F finds the files that contain the fixed string.
# One sed process then edits all of them.
rg -F -l -0 "$find_this" "$@" |
  xargs -0 sed -i '' "s/$sed_find/$sed_replace/g"
